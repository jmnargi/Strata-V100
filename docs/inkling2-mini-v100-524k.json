{
  "exe": "build-ik2/strata-ik2",
  "args": [
    "--model",
    "models/inkling2-mini/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "--gpus",
    "2",
    "--max-context",
    "524288",
    "--chunk",
    "3072",
    "--eos",
    "200006,199999"
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "CUDA_VISIBLE_DEVICES": "0,1",
    "IK2_BATCH_PREFILL": "1",
    "IK2_EP": "1",
    "IK2_EP_DEVICE": "1",
    "IK2_EP_SPLIT": "0.85",
    "IK2_KV": "fp8",
    "IK2_DENSE": "q8",
    "IK2_ATTN_GQA": "1"
  },
  "tokenizer": "models/inkling2-mini/tokenizer",
  "model_name": "inkling-2-mini",
  "reasoning_effort": "none"
}
